# 本地私密配置，不提交（已在 .gitignore 忽略）

# ===== 项目基础配置 =====
API_PORT=3001
DATABASE_URL=postgresql://werewolf:werewolf@localhost:5432/werewolf?schema=public
REDIS_URL=redis://localhost:6379

# ===== 队列配置 =====
# Worker 并发数（默认 1，避免 LLM API 限速）
GAME_WORKER_CONCURRENCY=1
GAME_MAX_DAYS=20
GAME_MAX_DURATION_MS=3600000
GAME_MAX_MODEL_FALLBACKS=2
# 非流式调用的总期限
LLM_CALL_TIMEOUT_MS=300000
# 发言、决策、复核和修订均使用流式调用：首个有效片段、相邻有效片段间隔、总期限
# 非空 reasoning_content、content 和工具参数片段计为有效进度；心跳不计
LLM_FIRST_CHUNK_TIMEOUT_MS=300000
LLM_STREAM_IDLE_TIMEOUT_MS=300000
LLM_STREAM_MAX_DURATION_MS=900000
LLM_CIRCUIT_MIN_SAMPLES=5
LLM_CIRCUIT_COOLDOWN_MS=30000

# ===== AGENT 配置 =====
ARK_API_KEY=ark-
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_DEFAULT_MODEL=deepseek-v4-flash
# 决策质量评估（LLM-as-judge）所用模型，缺省回退 ARK_DEFAULT_MODEL
JUDGE_MODEL=
ENGINE_MODE=llm

# ===== Skill 配置 =====
# Skill 文件存储路径（可选，默认为 src/skills）
# 本地开发：留空使用默认路径
# 服务器部署：设置为绝对路径，如 /app/skills 或 /data/werewolf/skills
SKILLS_DIR=

# ===== LangFuse 追踪（可选，两个密钥留空即关闭追踪）=====
# 面板由 docker-compose 的 observability profile 提供：pnpm docker:langfuse
# 首次访问 http://localhost:3100 注册账号并创建项目，拿到下面两个密钥
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3100

# ===== 日志配置 =====
# 取值：trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# 玩家回合复核次数上限，0 仅用于无反思对照；通过即结束
TURN_REFLECTION_MAX_ROUNDS=3
