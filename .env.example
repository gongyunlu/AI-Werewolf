# 本地私密配置，不提交（已在 .gitignore 忽略）

# ===== 项目基础配置 =====
API_PORT=3001
DATABASE_URL=postgresql://werewolf:werewolf@localhost:5432/werewolf?schema=public
REDIS_URL=redis://localhost:6379

# ===== 队列配置 =====
# Worker 并发数（默认 1，避免 LLM API 限速）
GAME_WORKER_CONCURRENCY=1

# ===== AGENT 配置 =====
ARK_API_KEY=ark-
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_DEFAULT_MODEL=deepseek-v4-flash
ENGINE_MODE=llm

# ===== Skill 配置 =====
# Skill 文件存储路径（可选，默认为 src/skills）
# 本地开发：留空使用默认路径
# 服务器部署：设置为绝对路径，如 /app/skills 或 /data/werewolf/skills
SKILLS_DIR=

# ===== LangSmith 追踪（可选，留空则静默降级不追踪）=====
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_
LANGCHAIN_PROJECT=ai-werewolf
