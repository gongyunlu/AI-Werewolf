{
  "name": "ai-werewolf",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11",
    "npm": "use pnpm please",
    "yarn": "use pnpm please"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @ai-werewolf/web dev",
    "dev:api": "pnpm --filter @ai-werewolf/api dev",
    "debug:api": "pnpm --filter @ai-werewolf/api dev:debug",
    "build": "pnpm -r run build",
    "preview": "pnpm -r --parallel run preview",
    "preview:web": "pnpm --filter @ai-werewolf/web preview",
    "preview:api": "pnpm --filter @ai-werewolf/api preview",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "check": "pnpm lint && pnpm typecheck",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mjs,cjs,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mjs,cjs,yml,yaml}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.1",
    "prettier": "^3.9.6",
    "typescript": "catalog:"
  }
}
