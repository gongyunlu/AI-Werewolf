{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "(?:game-dispatch|game-recovery|bootstrap|agent-access|submission-protocol|stream-delivery|ordinary-vote|model-stage)\\.integration-spec\\.ts$",
  "testTimeout": 30000,
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": { "rootDir": ".." } }]
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../src/$1",
    "^langfuse-langchain$": "<rootDir>/../src/testing/mocks/langfuse-langchain.ts",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
