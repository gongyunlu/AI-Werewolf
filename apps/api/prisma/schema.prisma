// Prisma schema
// 文档: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// 对局规则
model Ruleset {
  id          String   @id @db.VarChar(64)
  name        String   @db.VarChar(128)
  playerCount Int      @map("player_count")
  definition  Json     @db.JsonB
  isFrozen    Boolean  @default(false) @map("is_frozen")
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  games       Game[]

  @@map("rulesets")
}

// 对局信息
model Game {
  id            String    @id @default(uuid()) @db.Uuid
  rulesetId     String    @map("ruleset_id") @db.VarChar(64)
  skillVersion  String    @map("skill_version") @db.VarChar(32)
  status        String    @default("created") @db.VarChar(32) // 对局状态，取值口径见 packages/shared 的 GAME_STATUSES
  winnerFaction String?   @map("winner_faction") @db.VarChar(16) // 胜利者阵营（好人/狼人），使用字符串存储而非 enum
  totalDays     Int?      @map("total_days") // 游戏总天数
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz
  endedAt       DateTime? @map("ended_at") @db.Timestamptz
  experiment    Json?     @db.JsonB // 冻结的实验分组、配对和输入版本

  ruleset           Ruleset            @relation(fields: [rulesetId], references: [id])
  players           Player[]
  events            Event[]
  memories          Memory[]
  agentPerformances AgentPerformance[]
  gameSummary       GameSummary?
  agentJudgments    AgentJudgment[]
  speechSummaries   SpeechSummary[]
  decisionJudgments DecisionJudgment[]
  memoryUsages      MemoryUsage[]
  patternCandidates PatternCandidate[]
  knowledgeUsages   KnowledgeUsage[]
  execution         GameExecution?
  effectBatchCommits EffectBatchCommit[]
  eventDeliveries   EventDeliveryOutbox[]

  @@map("games")
}

// AI Agent 持久身份，跨对局存在。
// Player 是"这局的一个座位快照"，Agent 是"这个 AI 参赛者的持久身份"。
// 同一 Agent 可被多次拉进不同对局，Memory 挂 Agent 实现跨局积累。
model Agent {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @unique @db.VarChar(64) // 唯一标识，如 "阿三"
  defaultModelName String   @map("default_model_name") @db.VarChar(64) // 默认模型，可被 Player.modelName 单局覆盖
  memoryLabel      String   @map("memory_label") @db.VarChar(128) // 当前记忆集标签，如 "张三"；改此字段等于切换到另一批 Memory
  // 自带接入端点，与 apiKeyCiphertext 成对出现；两者都为空时回落到环境变量里的默认接入
  baseUrl          String?  @map("base_url") @db.VarChar(512)
  apiKeyCiphertext String?  @map("api_key_ciphertext") @db.Text // 自带密钥的 AES-256-GCM 密文，只写不读，不经由任何读接口返回
  // 密钥末 4 位，只用于读接口给出可辨认的掩码；独立存储使读接口不依赖 AGENT_SECRET_KEY，换主密钥不会让列表接口失效
  apiKeyHint       String?  @map("api_key_hint") @db.VarChar(4)
  tag              String?  @map("tag") @db.VarChar(64) // 单值自由文本标签，仅供使用者识别与筛选，不参与模型路由
  isActive         Boolean  @default(true) @map("is_active") // 软删除：false 时不可再被开局选中，但历史 Player 外键仍有效
  notes            String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  memories  Memory[]
  players   Player[]
  judgments AgentJudgment[]

  @@map("agents")
}

// 对局中的玩家信息（Agent 在这局的座位快照）
model Player {
  id                  String  @id @default(uuid()) @db.Uuid
  gameId              String  @map("game_id") @db.Uuid
  agentId             String  @map("agent_id") @db.Uuid // 引用的持久 Agent 身份
  seatNo              Int?    @map("seat_no") @db.SmallInt // 游戏中的座次号
  role                String? @db.VarChar(32) // 游戏角色，板子(Ruleset.definition.roles)驱动，取值口径见 packages/shared 的 ROLES
  faction             String? @db.VarChar(16) // 所属阵营，取值口径见 packages/shared 的 FACTIONS（villager/werewolf）
  displayName         String  @map("display_name") @db.VarChar(64) // 开局时从 Agent.name 拷贝，可本局覆盖
  modelName           String  @map("model_name") @db.VarChar(64) // 开局时从 Agent.defaultModelName 拷贝快照，历史局不受 Agent 升级影响
  // 开局时从 Agent.memoryLabel 拷贝快照，历史局不受 Agent 换记忆影响；用于回溯"这局当时用的是哪批记忆"
  memoryLabelSnapshot String  @map("memory_label_snapshot") @db.VarChar(128)
  // 开局冻结实际端点及凭证来源；旧数据的 NULL 表示未记录默认端点。
  // 同端点允许使用最新密钥，凭证来源的端点变化时终止，禁止把新端点密钥发往旧端点。
  accessBaseUrl       String? @map("access_base_url") @db.VarChar(512)
  accessUsesDefault   Boolean @default(false) @map("access_uses_default")
  deathDay            Int?    @map("death_day") @db.SmallInt // 玩家死亡的天数
  // 玩家死亡原因，取值口径见 packages/shared 的 DEATH_CAUSES（night_kill/execution/hunter_shot/witch_poison）
  deathCause          String? @map("death_cause") @db.VarChar(32)
  isSheriff           Boolean @default(false) @map("is_sheriff") // 是否是警长

  game              Game               @relation(fields: [gameId], references: [id], onDelete: Cascade)
  agent             Agent              @relation(fields: [agentId], references: [id]) // Agent 不可硬删（软删走 isActive），故不设 onDelete
  events            Event[]
  agentPerformances AgentPerformance[]
  decisionJudgments DecisionJudgment[]
  memoryUsages      MemoryUsage[]
  knowledgeUsages   KnowledgeUsage[]

  @@unique([gameId, seatNo])
  @@unique([gameId, agentId]) // 同一 Agent 一局最多一个座位
  @@map("players")
}

// 事件溯源不可变日志，记录对局中所有发生的动作。
// 设计原则：
// - 业务层不可变：不存在修改/删除事件的业务操作，只 INSERT，保证事件流完整可追溯。
// - 所有 Game/Player 状态变更本质上是该表的投影，可从事件流回放重建任何时刻的游戏状态。
// 注：下方 actor 关系的 onDelete: SetNull 是数据库层的引用完整性动作，非业务写操作；
//     且 Player 仅随 Game 级联删除（那时 Event 一并删除），故 SetNull 实际不会单独触发，与业务层不可变不冲突。
model Event {
  id         String   @id @default(uuid()) @db.Uuid
  gameId     String   @map("game_id") @db.Uuid // 所属对局
  sequence   Int      @db.Integer // 对局内全局递增顺序号（从1开始），用于保证事件严格有序
  effectKey  String?  @unique @map("effect_key") @db.VarChar(300) // 历史事件保持 NULL，不推测业务键
  payloadHash String? @map("payload_hash") @db.Char(64)
  source     Json?    @db.JsonB // 已采用模型产物引用；与事件同事务保存，历史保持 NULL
  day        Int?     @db.SmallInt // 游戏天数，0=准备阶段，null=对局外的元事件
  phase      String   @db.VarChar(32) // 阶段，取值口径见 packages/shared 的 PHASES（night/day_announce/speech/vote/execute/check_win）
  actionType String   @map("action_type") @db.VarChar(64) // 事件类型，取值口径见 packages/shared 的 ACTION_TYPES；决定同行 content(JSON)的负载结构如何解读
  // 事件可见性，取值口径见 packages/shared 的 VISIBILITY_TYPES：
  //   public - 所有人可见（白天发言、死讯公布、投票结果）
  //   wolf   - 狼人可见（狼人刀人决策）
  //   seer   - 预言家可见（预言家查验结果）
  //   witch  - 女巫可见（女巫用药决策、刀口信息）
  //   guard  - 守卫可见（守卫守护记录）
  //   system - 系统内部（不对任何玩家可见）
  visibility String   @default("public") @db.VarChar(16)
  actorId    String?  @map("actor_id") @db.Uuid // 动作执行者，NULL 表示系统事件
  targetIds  Json?    @map("target_ids") @db.JsonB // 目标玩家ID数组，如 ["uuid1","uuid2"]，具体场景：死亡结算、平票 PK、殉情双死、平安夜（空数组）
  content    Json     @db.JsonB // 事件负载，结构随 actionType 变化（发言文本、投票详情、夜间行动结果等）
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz // 记录写入时间，不可修改

  game              Game               @relation(fields: [gameId], references: [id], onDelete: Cascade)
  actor             Player?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
  memories          Memory[]
  memoryUsages      MemoryUsage[]
  knowledgeUsages   KnowledgeUsage[]
  judgments         AgentJudgment[]
  decisionJudgments DecisionJudgment[]

  @@unique([gameId, sequence]) // 事件溯源要求对局内 sequence 严格有序不重号，用约束而非 worker 并发度来保证
  @@map("events")
}

// 同时行动的最小提交凭证；包括无事件结果，不承担玩家认知或消息交付状态。
model EffectBatchCommit {
  batchKey    String   @id @map("batch_key") @db.VarChar(300)
  gameId      String   @map("game_id") @db.Uuid
  payloadHash String   @map("payload_hash") @db.Char(64)
  outcomes    Json     @db.JsonB
  eventIds    String[] @map("event_ids") @db.Uuid
  committedAt DateTime @default(now()) @map("committed_at") @db.Timestamptz
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@map("effect_batch_commits")
}

// 与领域事实同事务保存交付意图；完成仅表示已交给广播层，不代表浏览器确认。
model EventDeliveryOutbox {
  deliveryKey   String    @id @map("delivery_key") @db.VarChar(350)
  gameId        String    @map("game_id") @db.Uuid
  batchKey      String?   @unique @map("batch_key") @db.VarChar(300)
  eventIds      String[]  @map("event_ids") @db.Uuid
  firstSequence Int       @map("first_sequence")
  lastSequence  Int       @map("last_sequence")
  playerDeaths  Json      @map("player_deaths") @db.JsonB
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz
  leaseToken    String?   @map("lease_token") @db.Uuid
  leaseUntil    DateTime? @map("lease_until") @db.Timestamptz
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  game          Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, firstSequence])
  @@index([deliveredAt, nextAttemptAt])
  @@map("event_delivery_outbox")
}

// Agent 长期记忆表，跨对局持久化，用于自我进化。
// 每条记忆属于特定玩家，可关联到产生它的对局和事件，也可由多局提炼生成。
model Memory {
  id                   String                       @id @default(uuid()) @db.Uuid
  agentId              String                       @map("agent_id") @db.Uuid // 所属 Agent，跨对局持久化
  label                String                       @db.VarChar(128) // 记忆集标签，配合 Agent.memoryLabel 实现"切换记忆版本"（如 "张三" → "张三super"）
  gameId               String?                      @map("game_id") @db.Uuid // 产生该记忆的对局（多局提炼时为 NULL）
  eventId              String?                      @map("event_id") @db.Uuid // 触发事件（可选）
  type                 String                       @db.VarChar(32) // 类型，取值口径见 packages/shared 的 MEMORY_TYPES
  title                String                       @db.VarChar(256) // 简短标题
  content              String                       @db.Text // 详细内容，自然语言或结构化 JSON
  importance           Float                        @default(0.5) @db.Real // 重要性评分 0.0~1.0
  confidence           Float                        @default(0.5) @db.Real // 置信度评分 0.0~1.0
  retrievalCount       Int                          @default(0) @map("retrieval_count") // 被检索使用次数
  lastRetrievedAt      DateTime?                    @map("last_retrieved_at") @db.Timestamptz // 最近一次被检索时间
  isActive             Boolean                      @default(true) @map("is_active") // 是否活跃（可归档）
  source               String?                      @db.VarChar(32) // 来源：auto/manual/seed/refined
  metadata             Json?                        @db.JsonB // 扩展元数据（如自定义标签、外部引用等）
  // 语义检索用嵌入向量，维度对齐火山方舟 doubao-embedding-vision (2048)。
  // 当前数据规模使用精确检索；规模增长后可评估 halfvec(2048) 表达式 HNSW 索引。
  embedding            Unsupported("vector(2048)")?
  embeddingModel       String?                      @map("embedding_model") @db.VarChar(128)
  embeddingDimension   Int?                         @map("embedding_dimension")
  embeddingContentHash String?                      @map("embedding_content_hash") @db.Char(64)
  embeddedAt           DateTime?                    @map("embedded_at") @db.Timestamptz
  createdAt            DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                     @updatedAt @map("updated_at") @db.Timestamptz

  agent            Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  game             Game?              @relation(fields: [gameId], references: [id], onDelete: SetNull)
  event            Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  sourceRelations  MemoryDerivation[] @relation("MemoryDerivationDerived")
  derivedRelations MemoryDerivation[] @relation("MemoryDerivationSource")
  usages           MemoryUsage[]

  @@index([agentId, label])
  @@index([agentId, type])
  @@index([agentId, importance])
  @@index([agentId, lastRetrievedAt])
  @@map("memories")
}

// 记忆注入使用记录：某次已落库行为使用了哪些记忆。
// 注入候选先暂存在 AgentContext，行为 Event 写入成功后才以 eventId 精确落库，
// 避免同一玩家同一天多次同类行为无法区分，也避免失败/降级调用污染学习样本。
model MemoryUsage {
  id       String @id @default(uuid()) @db.Uuid
  memoryId String @map("memory_id") @db.Uuid
  gameId   String @map("game_id") @db.Uuid
  playerId String @map("player_id") @db.Uuid
  eventId  String? @map("event_id") @db.Uuid
  // 注入场景，取值口径见 packages/shared 的 AGENT_SCENARIOS
  scenario String @db.VarChar(32)
  // 本次注入服务的行为类型，取值口径见 packages/shared 的 ACTION_TYPES。
  // 单独存而非从 scenario 推导：女巫一夜内解药/毒药是两次独立注入，同属 night_action 场景
  actionType     String   @map("action_type") @db.VarChar(64)
  day            Int      @db.SmallInt
  triggerMatched Boolean  @default(false) @map("trigger_matched") // 记忆的触发条件是否匹配当次场景，用于信用分配
  rewardScore    Int?     @map("reward_score") @db.SmallInt // 关联行为的评分，尚未回填
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  event  Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([memoryId])
  @@index([gameId, playerId])
  @@index([eventId])
  @@unique([memoryId, eventId])
  @@map("memory_usages")
}

// 记忆提炼的显式溯源关系。固化记忆仍可保持 isActive=true，来源关系与检索状态互不耦合。
model MemoryDerivation {
  derivedMemoryId String   @map("derived_memory_id") @db.Uuid
  sourceMemoryId  String   @map("source_memory_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  derivedMemory Memory @relation("MemoryDerivationDerived", fields: [derivedMemoryId], references: [id], onDelete: Cascade)
  sourceMemory  Memory @relation("MemoryDerivationSource", fields: [sourceMemoryId], references: [id], onDelete: Cascade)

  @@id([derivedMemoryId, sourceMemoryId])
  @@index([sourceMemoryId])
  @@map("memory_derivations")
}

// 全局共享记忆表，存储跨对局、跨玩家的通用知识和统计规律。
model GlobalMemory {
  id                   String                       @id @default(uuid()) @db.Uuid
  type                 String                       @db.VarChar(32) // 类型，取值口径见 packages/shared 的 GLOBAL_MEMORY_TYPES
  title                String                       @db.VarChar(256) // 简短标题
  content              String                       @db.Text // 详细内容
  importance           Float                        @default(0.5) @db.Real
  confidence           Float                        @default(0.5) @db.Real
  source               String?                      @db.VarChar(32) // 来源：auto_stats/manual/aggregated
  retrievalCount       Int                          @default(0) @map("retrieval_count")
  lastRetrievedAt      DateTime?                    @map("last_retrieved_at") @db.Timestamptz
  isActive             Boolean                      @default(true) @map("is_active")
  tags                 Json?                        @db.JsonB // 标签，如 ["wolf","night1","kill"]
  sourceGameIds        Json?                        @map("source_game_ids") @db.JsonB // 晋升溯源：来源对局 id 列表
  // 语义检索用嵌入向量，口径同 Memory.embedding。
  embedding            Unsupported("vector(2048)")?
  embeddingModel       String?                      @map("embedding_model") @db.VarChar(128)
  embeddingDimension   Int?                         @map("embedding_dimension")
  embeddingContentHash String?                      @map("embedding_content_hash") @db.Char(64)
  embeddedAt           DateTime?                    @map("embedded_at") @db.Timestamptz
  createdAt            DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                     @updatedAt @map("updated_at") @db.Timestamptz

  @@index([type])
  @@index([importance])
  @@index([lastRetrievedAt])
  @@map("global_memories")
}

// pattern 晋升的聚类中间态：对局级复盘产出的 pattern 候选，语义聚类后达门槛晋升为 GlobalMemory。
model PatternCandidate {
  id                   String                       @id @default(uuid()) @db.Uuid
  gameId               String                       @map("game_id") @db.Uuid // 簇代表来源对局（最早出现）
  title                String                       @db.VarChar(256)
  content              String                       @db.Text
  importance           Float                        @default(0.5) @db.Real
  sourceGameIds        Json                         @map("source_game_ids") @db.JsonB // 该簇已出现的对局 id（去重）
  promotedAt           DateTime?                    @map("promoted_at") @db.Timestamptz // 晋升时间，null=未晋升
  // 聚类比对用嵌入向量，口径同 Memory.embedding。
  embedding            Unsupported("vector(2048)")?
  embeddingModel       String?                      @map("embedding_model") @db.VarChar(128)
  embeddingDimension   Int?                         @map("embedding_dimension")
  embeddingContentHash String?                      @map("embedding_content_hash") @db.Char(64)
  embeddedAt           DateTime?                    @map("embedded_at") @db.Timestamptz
  createdAt            DateTime                     @default(now()) @map("created_at") @db.Timestamptz

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([promotedAt])
  @@map("pattern_candidates")
}

// 玩家单局表现度量，用于记忆进化和性能分析。
model AgentPerformance {
  id                  String   @id @default(uuid()) @db.Uuid
  gameId              String   @map("game_id") @db.Uuid
  playerId            String   @map("player_id") @db.Uuid
  role                String   @db.VarChar(32) // 取值口径见 packages/shared 的 ROLES（从 Player 冗余复制）
  faction             String   @db.VarChar(16) // 取值口径见 packages/shared 的 FACTIONS
  survivalDays        Int      @map("survival_days") @db.SmallInt
  deathCause          String?  @map("death_cause") @db.VarChar(32) // 取值口径见 packages/shared 的 DEATH_CAUSES
  isWinner            Boolean  @map("is_winner")
  voteAccuracy        Float?   @map("vote_accuracy") @db.Real
  abilityUseCount     Int      @default(0) @map("ability_use_count")
  speechCount         Int      @default(0) @map("speech_count")
  speechAvgTokens     Int?     @map("speech_avg_tokens")
  reflectionGenerated Boolean  @default(false) @map("reflection_generated")
  score               Float?   @db.Real
  metadata            Json?    @db.JsonB
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([gameId, playerId])
  @@index([playerId])
  @@map("agent_performances")
}

/// 对局结束后的统计摘要，便于快速查询和分析。
/// 所有计数类字段为去规范化缓存，权威写入方是对局结束时的结算服务（读取 Event/Player 聚合后写入），
/// 业务代码只读，不直接修改这些字段。
model GameSummary {
  id                   String   @id @default(uuid()) @db.Uuid
  gameId               String   @unique @map("game_id") @db.Uuid
  totalDays            Int      @map("total_days") @db.SmallInt
  winnerFaction        String   @map("winner_faction") @db.VarChar(16) // 取值口径见 packages/shared 的 FACTIONS
  // 按阵营统计存活人数（源数据来自 Player 表），三列一一对应 FACTIONS 三个阵营
  villagerAliveCount   Int      @map("villager_alive_count") @db.SmallInt // villager 阵营存活数（含预言家/女巫等神职）
  werewolfAliveCount   Int      @map("werewolf_alive_count") @db.SmallInt // werewolf 阵营存活数
  thirdPartyAliveCount Int      @default(0) @map("third_party_alive_count") @db.SmallInt // third_party 阵营存活数（多数板子无，默认 0）
  keyEvents            Json?    @map("key_events") @db.JsonB // 关键事件摘要
  mvpPlayerId          String?  @map("mvp_player_id") @db.Uuid // 本局 MVP 玩家
  totalSpeechCount     Int      @map("total_speech_count") // 发言总数（从 Event 聚合）
  // 上帝视角复盘，对局结束后由 LLM 生成，存 JSON（复盘正文 + 关键转折 + 板子规律）。
  // 本表其余字段均为确定性统计且由结算服务写入，此列是唯一的 LLM 产物。
  narrative            String?  @db.Text
  generatedAt          DateTime @default(now()) @map("generated_at") @db.Timestamptz

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@map("game_summaries")
}

// 决策质量评估（LLM-as-judge），对可归属到单个玩家的关键决策（查验/用药/投票）打分。
// 每个已提交决策仅保留一行采用投影，完整结果和重评历史由 Langfuse 管理。
model DecisionJudgment {
  source Json? @db.JsonB // 仅为已采用的 Langfuse Score 引用；旧评分保持 NULL
  evaluationRunId String? @map("evaluation_run_id") @db.VarChar(200)
  id           String   @id @default(uuid()) @db.Uuid
  gameId       String   @map("game_id") @db.Uuid
  playerId     String   @map("player_id") @db.Uuid
  eventId      String   @unique @map("event_id") @db.Uuid // 被评估的决策事件
  actionType   String   @map("action_type") @db.VarChar(32) // seer_check/vote/witch_save/witch_poison
  day          Int      @db.SmallInt
  targetSeatNo Int?     @map("target_seat_no") @db.SmallInt
  verdict      String   @db.VarChar(16) // good/fair/poor
  score        Int      @db.SmallInt // 0-100
  reasoning    String?  @db.Text
  modelName    String   @map("model_name") @db.VarChar(64) // 评估所用 judge 模型
  evaluationVersion Int @default(1) @map("evaluation_version")
  previousEvaluations Json @default("[]") @map("previous_evaluations") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([playerId, actionType])
  @@map("decision_judgments")
}

// Agent 对发言的主观判断（个性化发言摘要）
model AgentJudgment {
  id            String   @id @default(uuid()) @db.Uuid
  agentId       String   @map("agent_id") @db.Uuid
  gameId        String   @map("game_id") @db.Uuid
  speechEventId String   @map("speech_event_id") @db.Uuid
  day           Int      @db.SmallInt
  speakerSeatNo Int      @map("speaker_seat_no") @db.SmallInt
  trustScore    Int      @map("trust_score") @db.SmallInt // 0-100
  suspicious    Boolean  @default(false)
  notes         String?  @db.Text
  relationship  String?  @db.VarChar(20) // 关系标识：'teammate'（队友）、'checked_good'（查验好人）、'checked_wolf'（查验狼人）、'silver'（银水）
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  agent       Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  game        Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  speechEvent Event @relation(fields: [speechEventId], references: [id], onDelete: Cascade)

  @@unique([agentId, speechEventId])
  @@index([agentId, gameId], map: "agent_judgments_agent_game_idx")
  @@index([gameId, day], map: "agent_judgments_day_idx")
  @@map("agent_judgments")
}

// 全局发言摘要（2天前发言的 LLM 概括，压缩上下文防止爆炸）
// 与 AgentJudgment 区别：判断是玩家主观（agentId 维度），摘要与玩家无关（全局共享）
model SpeechSummary {
  id        String   @id @default(uuid()) @db.Uuid
  gameId    String   @map("game_id") @db.Uuid
  day       Int      @map("day") @db.SmallInt
  seatNo    Int      @map("seat_no") @db.SmallInt
  summary   String   @map("summary") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, day, seatNo])
  @@index([gameId, day])
  @@map("speech_summaries")
}

// 攻略知识库：把 data/ 下的非结构化攻略清洗、切块后经 LLM 蒸馏成 {role, scenario, trigger, action}
// 的结构化战术条目，注入 agent 决策链作「通用战术层」。与 memories 独立：memories 是 agent 自学习经验
// （agent_id NOT NULL + 衰减/归档），攻略是外部静态语料。原文与蒸馏条目在同一行双写。
// 取值的 role 用开放字符串（取值口径见 packages/shared 的 ROLES，'any' 表示不限）、
// scenario 用 packages/shared 的 AGENT_SCENARIOS，'any' 表示跨场景。检索时角色/场景在 SQL 层硬过滤
// （embedding 区分不了「我是女巫 vs 我是预言家」），再按 cosine 相似度取 top-k。
model KnowledgeChunk {
  id        String   @id @default(uuid()) @db.Uuid
  // 语料来源文件（相对 data/ 的文件名），用于审计与重建
  sourceFile String  @map("source_file") @db.VarChar(128)
  // 所属攻略文章标题（## 标题），作为章节锚点
  articleTitle String @map("article_title") @db.VarChar(256)
  // 小节标题（### / <strong> 显式小标题），可为空
  sectionTitle String? @map("section_title") @db.VarChar(256)
  role     String   @db.VarChar(32) // 适用角色，取值口径见 packages/shared 的 ROLES 或 'any'
  scenario String   @db.VarChar(32) // 适用场景，取值口径见 packages/shared 的 AGENT_SCENARIOS 或 'any'
  // LLM 蒸馏出的触发条件与行动建议（结构化条目）
  trigger String   @db.Text
  action  String   @db.Text
  // 清洗后的原文段落（蒸馏的输入、可切换注入源的兜底）
  content String   @db.Text
  isActive Boolean  @default(true) @map("is_active")
  version String @default("legacy") @db.VarChar(64)
  sourceHash String? @map("source_hash") @db.Char(64)
  applicability Json? @db.JsonB // 经过审核的板子、动作与触发条件
  // 语义向量，口径对齐 doubao-embedding-vision (2048)，写走 $queryRaw/$executeRaw，故此处 Unsupported
  embedding            Unsupported("vector(2048)")?
  embeddingModel       String?  @map("embedding_model") @db.VarChar(128)
  embeddingDimension   Int?     @map("embedding_dimension")
  embeddingContentHash String?  @map("embedding_content_hash") @db.Char(64)
  embeddedAt           DateTime? @map("embedded_at") @db.Timestamptz
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  usages KnowledgeUsage[]

  @@index([role, scenario])
  @@unique([version, sourceHash])
  @@map("knowledge_chunks")
}

// 攻略注入使用记录：某次已落库行为注入了哪些知识块。
// 与 MemoryUsage 同构——注入候选先暂存在 AgentContext，行为 Event 写入成功后才以 eventId 精确落库，
// 避免失败/降级调用污染样本；质量分析通过 Event 关联当前采用的 DecisionJudgment，
// 供度量「攻略是否提升对局质量」（注入 vs 未注入组的评分对比）。
model KnowledgeUsage {
  id       String @id @default(uuid()) @db.Uuid
  chunkId  String @map("chunk_id") @db.Uuid
  gameId   String @map("game_id") @db.Uuid
  playerId String @map("player_id") @db.Uuid
  eventId  String? @map("event_id") @db.Uuid
  // 注入场景，取值口径见 packages/shared 的 AGENT_SCENARIOS
  scenario String @db.VarChar(32)
  // 本次注入服务的行为类型，取值口径见 packages/shared 的 ACTION_TYPES
  actionType String @map("action_type") @db.VarChar(64)
  day        Int @db.SmallInt
  // 历史兼容列：停止回填，现有值保留；质量分析通过 Event 读取采用评分
  rewardScore Int? @map("reward_score") @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  chunk  KnowledgeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  game   Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  event  Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([chunkId])
  @@index([gameId, playerId])
  @@index([eventId])
  @@unique([chunkId, eventId])
  @@map("knowledge_usages")
}

// 已完成节点和行动记录属于同一执行版本，接管后旧执行者不能继续提交。
model GameExecution {
  gameId      String   @id @map("game_id") @db.Uuid
  generation  Int      @default(1)
  dispatchPending Boolean @default(false) @map("dispatch_pending")
  owner       String?  @db.Uuid
  initialState Json    @map("initial_state") @db.JsonB
  manifest    Json     @db.JsonB
  deadline    DateTime @db.Timestamptz
  heartbeatAt DateTime? @map("heartbeat_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  steps       GameExecutionStep[]

  @@map("game_executions")
}

model GameExecutionStep {
  gameId    String   @map("game_id") @db.Uuid
  key       String   @db.VarChar(240)
  input     Json?    @db.JsonB
  output    Json?    @db.JsonB
  completed Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  execution GameExecution @relation(fields: [gameId], references: [gameId], onDelete: Cascade)

  @@id([gameId, key])
  @@map("game_execution_steps")
}

// 一次检索的完整候选与过滤记录，零命中和故障也独立记录。
model KnowledgeRetrieval {
  id String @id @default(uuid()) @db.Uuid
  gameId String @map("game_id") @db.Uuid
  playerId String @map("player_id") @db.Uuid
  eventId String? @map("event_id") @db.Uuid
  query String @db.Text
  result Json @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@index([gameId, playerId])
  @@map("knowledge_retrievals")
}

// 保存行为当时的输入，供盲评和固定局面重放；独立于不可变事件日志。
model DecisionContext {
  eventId String @id @map("event_id") @db.Uuid
  gameId String @map("game_id") @db.Uuid
  playerId String @map("player_id") @db.Uuid
  snapshot Json @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@index([gameId])
  @@map("decision_contexts")
}

model TeamJudgment {
  source Json? @db.JsonB // 已采用的平台评分引用，不保存新评分历史
  evaluationRunId String? @map("evaluation_run_id") @db.VarChar(200)
  eventId String @id @map("event_id") @db.Uuid
  gameId String @map("game_id") @db.Uuid
  faction String @db.VarChar(16)
  actionType String @map("action_type") @db.VarChar(64)
  score Int @db.SmallInt
  verdict String @db.VarChar(16)
  reasoning String @db.Text
  modelName String @map("model_name") @db.VarChar(64)
  evaluationVersion Int @map("evaluation_version")
  previousEvaluations Json @default("[]") @map("previous_evaluations") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@index([gameId])
  @@map("team_judgments")
}

model EvaluationRun {
  id String @id @db.VarChar(200)
  gameId String @map("game_id") @db.Uuid
  expectedEventIds String[] @map("expected_event_ids") @db.Uuid
  status String @default("pending") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  definition Json? @db.JsonB // 未完成时冻结 evaluator 输入定义；完成后仅保留平台版本引用
  pendingResults Json @default("{}") @map("pending_results") @db.JsonB // 暂存判分及交付凭据，采用后清空
  deliveredEventIds String[] @default([]) @map("delivered_event_ids") @db.Uuid
  selection Json? @db.JsonB // 显式采用的外部 Score 身份；普通 evaluator 结果按 run/event 推导
  @@index([gameId, createdAt])
  @@map("evaluation_runs")
}
